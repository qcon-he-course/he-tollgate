<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet id="2017-003-haulier" author="rmistry">
        <createTable tableName="haulier">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="name" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="contact_name" type="VARCHAR(100)"/>
            <column name="contact_email" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="phone" type="VARCHAR(30)"/>
            <column name="address_line1" type="VARCHAR(200)"/>
            <column name="town" type="VARCHAR(100)"/>
            <column name="postcode" type="VARCHAR(10)"/>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="2017-003-operator-licence" author="rmistry">
        <createTable tableName="operator_licence">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="haulier_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_licence_haulier" references="haulier(id)"/>
            </column>
            <column name="licence_number" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="valid_from" type="DATE"><constraints nullable="false"/></column>
            <column name="expiry_date" type="DATE"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="2017-003-insurance-policy" author="rmistry">
        <createTable tableName="insurance_policy">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="haulier_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_insurance_haulier" references="haulier(id)"/>
            </column>
            <column name="insurer" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="policy_number" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="start_date" type="DATE"><constraints nullable="false"/></column>
            <column name="end_date" type="DATE"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="2017-003-vehicle" author="rmistry">
        <createTable tableName="vehicle">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="haulier_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_vehicle_haulier" references="haulier(id)"/>
            </column>
            <column name="registration" type="VARCHAR(10)"><constraints nullable="false" unique="true"/></column>
            <column name="category" type="VARCHAR(20)"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="2017-003-app-user" author="koduya">
        <createTable tableName="app_user">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="username" type="VARCHAR(50)"><constraints nullable="false" unique="true"/></column>
            <column name="password_hash" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="full_name" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="email" type="VARCHAR(200)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="2017-003-user-role" author="koduya">
        <createTable tableName="user_role">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_user_role_user" references="app_user(id)"/>
            </column>
            <column name="role" type="VARCHAR(20)"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="user_role" columnNames="user_id, role" constraintName="pk_user_role"/>
    </changeSet>

</databaseChangeLog>
