<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!-- Test hauliers for UAT. Names and details are made up. -->
    <changeSet id="2017-101-demo-hauliers" author="rmistry" context="demo">
        <loadData tableName="haulier" file="db/changelog/2017/demo-hauliers.csv" separator=";">
            <column name="id" type="NUMERIC"/>
            <column name="created_at" type="DATETIME"/>
        </loadData>
        <sql>SELECT setval(pg_get_serial_sequence('haulier', 'id'), (SELECT MAX(id) FROM haulier))</sql>
        <loadData tableName="operator_licence" file="db/changelog/2017/demo-licences.csv" separator=";">
            <column name="haulier_id" type="NUMERIC"/>
            <column name="valid_from" type="DATE"/>
            <column name="expiry_date" type="DATE"/>
        </loadData>
        <loadData tableName="insurance_policy" file="db/changelog/2017/demo-insurance.csv" separator=";">
            <column name="haulier_id" type="NUMERIC"/>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
        </loadData>
        <loadData tableName="vehicle" file="db/changelog/2017/demo-vehicles.csv" separator=";">
            <column name="haulier_id" type="NUMERIC"/>
        </loadData>
    </changeSet>

</databaseChangeLog>
